{% extends "skeleton.html.twig" %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('styles/profile.css') }}">
{% endblock %}
{% block javascripts %}
	{% block importmap %}
		{{ importmap('app') }}
	{% endblock %}
	<script src="{{ asset('profile.js') }}"></script>
{% endblock %}
{% block main %}
	<div class="container py-5 min-vh-100">
		<div class="row">
			<div class="col-lg-4 mb-4">
				<div class="card shadow-sm border-0 profile-card-custom p-4 mb-4">
					<div class="ratio ratio-1x1 mb-3" style="width: 120px;">
						<img src="https://img.a.transfermarkt.technology/portrait/big/8198-1748102259.jpg?lm=1" class="rounded-circle object-fit-cover shadow-sm">
					</div>
					<h3 class="fw-bold">{{ usuario.UserName }}</h3>
					{% if usuario.userId == app.user.UserId %}
						<button id="edit-profile-btn" class="btn btn-primary w-100 mt-2" style="max-width: 200px;" data-bs-toggle="modal" data-bs-target="#editProfileModal">Edit profile</button>
					{% endif %}
					{% if is_granted('ROLE_ADMIN') %}
						<a href="#" class="delete-account-link mt-2" style="max-width:200px;display:block;margin-left:auto;margin-right:auto;">Delete account</a>
					{% endif %}
				</div>

				<div class="card shadow-sm border-0 p-4 card-comments">
					<h5 class="fw-bold mb-4">Last reviews made by
						{{ usuario.UserName }}</h5>
					<div class="comments-section">
						{% if ultimos %}
							{% for last in ultimos %}
								<div class="comment-item">
									<img src="{{ last.marca.urlLogo }}" class="comment-avatar" alt="Avatar">
									<div class="comment-body">
										<span class="comment-author">{{ last.modelo.modeloNombre }}<small class="text-muted small ms-2 time-ago" data-timestamp="{{ last.valoracion.fecha|date('U') }}"></small>
										</span>
										{% if last.valoracion.comentario is not null or last.valoracion.comentario != "" %}
											<p class="comment-text">{{ last.valoracion.comentario }}</p>
										{% endif %}
										<div class="rating-static">
											{% if last.valoracion.estrellas > 0 %}
												{% for i in 1..last.valoracion.estrellas %}
													<svg class="gold" viewbox="0 0 24 24">
														<path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
													</svg>
												{% endfor %}
											{% endif %}

											{% if last.valoracion.estrellas < 5 %}
												{% for i in (last.valoracion.estrellas + 1)..5 %}
													<svg class="grey" viewbox="0 0 24 24" style="fill: #e8e8e8;">
														<path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
													</svg>
												{% endfor %}
											{% endif %}
										</div>
										<div class="small text-muted mt-1">
											{% if last.coche.motor.nombreMotor %}
												<span class="me-2">
													<strong>Engine:</strong>
													{{ last.coche.motor.nombreMotor }}</span>
											{% endif %}
											{% if last.coche.cocheColor %}
												<span class="me-2">
													<strong>Color:</strong>
													{{ last.coche.cocheColor }}</span>
											{% endif %}
											{% if last.coche.cocheAnio %}
												<span class="me-2">
													<strong>Year:</strong>
													{{ last.coche.cocheAnio }}</span>
											{% endif %}
											{% if last.coche.cocheTransmision %}
												<span class="me-2">
													<strong>Transmission:</strong>
													{{ last.coche.cocheTransmision }}</span>
											{% endif %}
										</div>
									</div>
								</div>
							{% endfor %}
						{% else %}
							<p>The user has not posted any reviews</p>
						{% endif %}
					</div>
				</div>
			</div>

			<div class="col-lg-8">
				<div class="gallery-section mb-5 cars-in-garage-section">
					<h2 class="mb-4 fw-bold text-center">Cars in garage</h2>
					<div class="carousel-flex-layout gallery-wrapper">
						{% if coches %}
							<button class="nav-btn btn-atras">
								<i class="arrow left"></i>
							</button>

							<div class="custom-scroll-container scroll-contenedor">
								{% for car in coches %}
									{% embed 'profile/carousel_card.html.twig' %}
										{% block image %}https://res.cloudinary.com/unix-center/image/upload/c_limit,dpr_3.0,f_auto,fl_progressive,g_center,h_580,q_75,w_906/tnt1sdreuccr9iqjyewf.jpg
										{% endblock %}
										{% block title %}
											{{ car.modelo.modeloNombre }}
										{% endblock %}
										{% block logo %}
											{{ car.marca.urlLogo }}
										{% endblock %}
										{% block stars %}
											{{ car.valoracion.estrellas|default(0) }}
										{% endblock %}
									{% endembed %}
								{% endfor %}
							</div>

							<button class="nav-btn btn-adelante">
								<i class="arrow right"></i>
							</button>
						{% else %}
							<p class="text-center">The user has not stored any cars in the garage.</p>
						{% endif %}
					</div>
				</div>

				<div class="gallery-section mb-5 most-rated-section">
					<h2 class="mb-4 fw-bold text-center">Most rated by
						{{usuario.UserName}}</h2>
					<div class="carousel-flex-layout gallery-wrapper">
						{% if valorados%}
							<button class="nav-btn btn-atras">
								<i class="arrow left"></i>
							</button>

							<div class="custom-scroll-container scroll-contenedor">
								{% for value in valorados %}
									
									{% embed 'profile/carousel_card.html.twig' %}
										{% block link %}<a href={{ path('marca', {name: value.marca.nombreMarca, id: value.modelo.modeloId }) }}>{% endblock %}
										{% block image %}
											{{ value.modelo.fotoModelo }}
										{% endblock %}
										{% block title %}
											{{ value.modelo.modeloNombre }}
										{% endblock %}
										{% block logo %}
											{{ value.marca.urlLogo }}
										{% endblock %}
										{% block stars %}
											{{ value.valoracion.estrellas|default(0) }}
										{% endblock %}
										{% block url %}
											{{ path('marca', { name: value.marca.nombreMarca, id: value.modelo.modeloId }) }}
										{% endblock %}
										{% block closeLink %}</a>{% endblock %}
									{% endembed %}
								{% endfor %}
							</div>

							<button class="nav-btn btn-adelante">
								<i class="arrow right"></i>
							</button>
						{% else %}
							<p>The user has not rated any car.</p>
						{% endif %}
					</div>
				</div>
			</div>
		</div>

		<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="editProfileModalLabel">Edit profile</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						<form id="ajax-editProfile-form" enctype="multipart/form-data" data-update-url="{{ path('profile_update', {'name': usuario.UserName}) }}">
							<div class="row g-4">
								<div class="col-md-6">
									<label class="form-label small fw-bold">Username:</label>
									<input type="text" name="username" class="form-control border-0 bg-light p-3" style="border-radius: 15px;" value="{{ usuario.UserName }}" required>
								</div>
								<div class="col-md-6">
									<label class="form-label small fw-bold">Email:</label>
									<input type="email" name="email" class="form-control border-0 bg-light p-3" style="border-radius: 15px;" value="{{ usuario.UserMail }}" required>
								</div>
								<div class="col-md-6">
									<label class="form-label small fw-bold">Profile pic:</label>
									<input type="file" id="garajeImage" name="garaje_image" class="form-control" accept="image/*">
								</div>
								<div class="col-12">
									<button type="submit" id="submit-form-btn" class="btn btn-primary w-100 py-3 fw-bold" style="border-radius: 18px;">Save changes</button>
									<a href="#" class="delete-account-link">Delete account</a>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	{% endblock %}
