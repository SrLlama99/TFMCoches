{% extends "skeleton.html.twig" %}
{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('styles/newObjects.css') }}">
{% endblock %}
{% block title %}Create new...
{% endblock %}
{% block main %}
	<div class="customnav p-3 d-flex justify-content-center flex-column container text-center">
		<h1>Create new...</h1>
		<div class="row ">
			<a class="col m-1 d-flex flex-column text-decoration-none text-white" href="{{ path('newItemGet',{"type":"brand"}) }}">
				<span class="text-white customNavBtn btn-secondary btn w-100">Brand</span>
				{% if brand %}
					<em>for example...</em>
					<div class="d-flex flex-column align-items-center m-3">
						<h3>{{brand.nombreMarca}}</h3>
						<img class="w-50" src="{{ brand.urlLogo }}"/>
					</div>
				{% endif %}
			</a>

			<a class="col m-1 d-flex flex-column text-decoration-none text-white" href="{{ path('newItemGet',{"type":"model"}) }}">
				<span class="text-white customNavBtn btn-secondary btn w-100">Model</span>
				{% if model %}
					<em>for example...</em>
					<div class="d-flex flex-column align-items-center m-3">
						<h3>{{model.modeloNombre}}</h3>
						<img class="w-50" src="{{ model.fotoModelo }}"/>
					</div>
				{% endif %}
			</a>
		</div>
	</div>
{% endblock %}
