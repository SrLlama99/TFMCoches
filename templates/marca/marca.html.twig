{% extends "skeleton.html.twig" %}
{% block title %}{{ marca.nombreMarca }}{% endblock %} 
{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('styles/marca.css') }}">
{% endblock %}


{% block importmap %}{{ importmap('app') }}
<script src="{{ asset('marca.js') }}"></script>
{% endblock %}

{% block main %}
	<div class="container py-5 d-flex flex-column justify-content-center">
		<div class="row justify-content-center">
			<div class="col-12 col-md-8 col-lg-6 mb-5">
				<div class="card shadow-sm profile-card-custom p-4 mb-4">
					<div class="ratio ratio-1x1 mb-3" style="width: 120px;">
						<img src="{{ asset(marca.Asset ) }}" class="rounded-circle object-fit-cover shadow-sm">
					</div>
					<a href="{{ marca.urlMarca }}">
						<h3 class="fw-bold bi bi-globe2 fs-2 d-flex align-items-center text-white">{{ marca.nombreMarca }}</h3>
					</a>
					{% if is_granted('ROLE_ADMIN') %}
						<div class="d-flex gap-2 w-100 mt-2" style="max-width: 360px;">
							<button class="btn btn-light flex-grow-1 text-danger" data-bs-toggle="modal" data-bs-target="#editBrandModal">Edit Brand</button>
							<button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteMarcaModal">
								Delete Brand
							</button>
						</div>
					{% endif %}
				</div>

			</div>

			<div class="col-12">
				<div class="gallery-section mb-5">
					<h2 class="mb-4 fw-bold text-center text-white">Models of the brand:</h2>
					<div class="carousel-flex-layout gallery-wrapper">
						{% if modelos %}
						<button class="nav-btn btn-atras">
							<i class="arrow left"></i>
						</button>
						<div class="custom-scroll-container scroll-contenedor">
							{% for model in modelos %}
								{% embed 'profile/carousel_card.html.twig' %}
									{% block link %}
										{{ path('marca', { name: marca.nombreMarca, id: model.modeloId }) }}
									{% endblock %}
									{% block image %}
										{{ asset(model.Asset) }}
									{% endblock %}
									{% block title %}
										{{ model.modeloNombre }}
									{% endblock %}
									{% block logo %}
										{{ asset(marca.Asset) }}
									{% endblock %}
									{% block stars %}
										{{ model.mediaValoraciones|default(0) }}
									{% endblock %}
								{% endembed %}
							{% endfor %}
						</div>
						<button class="nav-btn btn-adelante">
							<i class="arrow right"></i>
						</button>
						{% else %}
						<h2 class="text-white text-center align-self-center">This brand has no models.</h2>
						<a class="btn btn-success customNavBtn p-2 text-decoration-none text-white" href="{{ path('newItemGet', {"type":'model'} )}}">Create a model</a>
						{% endif %}
					</div>
				</div>
			</div>
		</div>

		<!-- Confirm delete modal -->
		<div class="modal fade" id="confirmDeleteMarcaModal" tabindex="-1" aria-labelledby="confirmDeleteMarcaLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="confirmDeleteMarcaLabel">Are you sure?</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete "{{ marca.nombreMarca }}"?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">No</button>
                        <a href="{{ path('app_borrarMarca', {id: marca.idMarca}) }}" class="btn btn-danger" id="confirm-delete-marca" role="button">Yes</a>
                    </div>
                </div>
            </div>
        </div>

		<!-- Edit Brand Modal -->
		<div class="modal fade" id="editBrandModal" tabindex="-1" aria-labelledby="editBrandModalLabel" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="editBrandModalLabel">Edit brand</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						<form id="ajax-editBrand-form" enctype="multipart/form-data" data-update-url="{{ path('marca_update', {'id': marca.idMarca}) }}">
							<div class="mb-3">
								<label class="form-label small fw-bold">Brand name</label>
								<input type="text" name="nombre" class="form-control" value="{{ marca.nombreMarca }}" required>
							</div>
							<div class="mb-3">
								<label class="form-label small fw-bold">Website URL</label>
								<input type="url" name="url" class="form-control" value="{{ marca.urlMarca }}">
							</div>
							<div class="mb-3">
								<label class="form-label small fw-bold">Logo (optional)</label>
								<input type="file" name="logo" class="form-control" accept="image/*">
							</div>
							<div class="mb-3 text-end">
								<button type="submit" id="submit-edit-brand" class="btn btn-light">Save changes</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	{% endblock %}
