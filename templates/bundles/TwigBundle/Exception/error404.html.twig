{% extends 'skeleton.html.twig' %}

{% block title %}404 - Page not found
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/error404.css') }}">
{% endblock %}

{% block main %}
	<div class="error-container">
		<div class="error-card">
			<h1 class="error-code">
				404
			</h1>
			<h2 class="error-title">
				Oops! Page not found
			</h2>
			<p class="error-text">
				The page you are looking for might have been removed, renamed or is temporarily unavailable.
			</p>
			<a href="{{ path('home') }}" class="error-button">
				Back to Home
			</a>
		</div>
	</div>
{% endblock %}
