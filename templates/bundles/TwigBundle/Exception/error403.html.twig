{% extends 'skeleton.html.twig' %}

{% block title %}
    403 - Access Denied
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/error403.css') }}">
{% endblock %}

{% block main %}

<div class="error-container">

    <div class="error-card customnav p-3">

        <h1 class="error-code">
            403
        </h1>

        <h2 class="error-title">
            Access Denied
        </h2>

        <p class="error-text">
            You do not have permission to access this page.
        </p>

        <a href="{{ path('home') }}" class="error-button">
            Return Home
        </a>

    </div>

</div>

{% endblock %}