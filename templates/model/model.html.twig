{% extends "skeleton.html.twig" %}
{% block title %}{{model.modeloNombre}}, {{model.marca.nombreMarca}}{% endblock %}
{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('styles/model.css') }}">
{% endblock %}

{% block javascripts %}
	{% block importmap %}{{ importmap('app') }}{% endblock %}
	<script>
	window.modelPageConfig = {
		profilePathTemplate: "{{ path('garage', {'name': '__USERNAME__'}) }}",
		isAdmin: {{ is_granted('ROLE_ADMIN') ? '1' : '0' }},
		initialCommentOffset: {{ (valoraciones is defined) ? valoraciones|length : 0 }},
		addRatingUrl: "{{ path('model_add_rating', {'modelId': model.modeloId}) }}",
		commentsUrl: "{{ path('model_comments', {'modelId': model.modeloId}) }}",
		valoracionDeleteUrlTemplate: "{{ path('valoracion_delete', {'id': '__ID__'}) }}",
	};
	</script>
	<script type="module" src="{{ asset('model.js') }}"></script>
{% endblock %}

{% block main %}
	<div class="container py-5 min-vh-100">
		<div
			class="main-grid">

			<div class="content-main">
				<div
					class="featured-photo-container">
					{# <img src="{{ asset(model.fotoModelo) }}" alt="Coche destacado" class="featured-photo"> #}
					<img src="{{ model.fotoModelo }}" alt="Coche destacado" class="featured-photo">
				</div>

				<div class="comments-container">
					<h4 class="fw-bold mb-4">Comments of the {{model.modeloNombre}}</h4>

					<div
						id="comments-wrapper" class="comments-list">
						{% if valoraciones is defined and valoraciones|length > 0 %}
							{% for v in valoraciones %}
								<div class="comment-item">
									<img src="{{ asset('assets/images/avatar/' ~ v.profilePic) }}" class="comment-avatar">
									<div class="comment-content">
										<h6 class="mb-0 fw-bold"><a href="{{ path('garage', {name: v.username}) }}" class="username-link">{{ v.username }}</a> <small class="text-white small ms-2 time-ago" data-timestamp="{{ v.fecha|date('U') }}"></small></h6>
										<p class="text-white small mb-1">{{ v.comentario }}</p>
										<div class="rating-static">
											{% for i in 1..5 %}
												<svg class="{{ i <= v.estrellas ? 'gold' : '' }}" viewbox="0 0 24 24">
													<path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
												</svg>
											{% endfor %}
										</div>
										<div class="small text-white mt-1">
											{% if v.motor %}<span class="me-2"><strong>Engine:</strong> {{ v.motor }}</span>{% endif %}
											{% if v.color %}<span class="me-2"><strong>Color:</strong> {{ v.color }}</span>{% endif %}
											{% if v.anio %}<span class="me-2"><strong>Year:</strong> {{ v.anio }}</span>{% endif %}
											{% if v.transmision %}<span class="me-2"><strong>Transmission:</strong> {{ v.transmision }}</span>{% endif %}
										</div>
									</div>
									{% if is_granted('ROLE_ADMIN') %}
										<button class="delete-comment-btn" data-delete-url="{{ path('valoracion_delete', {'id': v.id}) }}" aria-label="Delete comment">✕</button>
									{% endif %}
								</div>
							{% endfor %}
						{% else %}
							<p class="text-white small">There are no comments yet.</p>
						{% endif %}
					</div>

					<button id="load-more-comments" class="load-more-btn">
						Load more comments
					</button>
				</div>
			</div>

				<!-- Confirm delete modal -->
				<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
			 	 <div class="modal-dialog modal-dialog-centered">
			 	 	 <div class="modal-content">
			 	 	 	 <div class="modal-header">
			 	 	 	 	 <h5 class="modal-title" id="confirmDeleteModalLabel">Are you sure?</h5>
			 	 	 	 	 <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			 	 	 	 </div>
			 	 	 	 <div class="modal-body text-center">
			 	 	 	 	 <p class="mb-4">Are you sure you want to delete this model?</p>
			 	 	 	 	 <div class="d-flex justify-content-center gap-2">
			 	 	 	 	 	 <a href="#" id="confirm-delete-yes" class="btn btn-danger py-3 fw-bold" style="border-radius:18px;">Yes</a>
			 	 	 	 	 	 <a href="#" id="confirm-delete-no" class="btn btn-light py-3 fw-bold" data-bs-dismiss="modal" style="border-radius:18px;">No</a>
			 	 	 	 	 </div>
			 	 	 	 </div>
			 	 	 </div>
			 	 </div>
			 	</div>

			<aside class="profile-sidebar">
				<a href="{{ path('marca', {'name': marca.nombreMarca, 'id': null}) }}">
					<img src="{{ marca.urlLogo }}" alt="Avatar" class="profile-avatar">
				</a>
				<h3 class="fw-bold mb-1">{{model.modeloNombre}}</h3>
				<p class="small text-white">{{marca.nombreMarca}}</p>

				<div class="w-100 mt-4">
					<div class="mb-3 border-bottom pb-2">
						<span class="d-block fw-bold small text-white text-uppercase">Average rating</span>
						<div class="rating-static">
							{% set estrellasMedia = model.mediaValoraciones %}

							{% if estrellasMedia > 0 %}
								{% for i in 1..estrellasMedia %}
									<svg class="gold" viewbox="0 0 24 24">
										<path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
									</svg>
								{% endfor %}
							{% endif %}

							{% if estrellasMedia < 5 %}
								{% for i in (estrellasMedia + 1)..5 %}
									<svg class="grey" viewbox="0 0 24 24">
										<path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
									</svg>
								{% endfor %}
							{% endif %}
						</div>
					</div>
					<div class="mb-3 border-bottom pb-2">
						<span class="d-block fw-bold small text-white text-uppercase">Engines</span>
						{% for nombre in listaMotores %}
							<span>{{ nombre }}</span><br>
						{% endfor %}
					</div>
					<div class="mb-3 border-bottom pb-2">
						<span class="d-block fw-bold small text-white text-uppercase">Colors</span>
                        {% for color in listaColores %}
						<span>{{color}}</span><br>
                        {% endfor %}
					</div>
					<div class="mb-3 border-bottom pb-2">
						<span class="d-block fw-bold small text-white text-uppercase">Years</span>
                        {% for year in listaAnios %}
						<span>{{year}}</span><br>
                        {% endfor %}
					</div>
                    <div class="mb-3 border-bottom pb-2">
						<span class="d-block fw-bold small text-white text-uppercase">Transmission</span>
                        {% for transmission in listaTransmisiones %}
						<span>{{transmission}}</span><br>
                        {% endfor %}
					</div>
				</div>

				{% if is_granted('ROLE_ADMIN') %}
				<a href="#" class="btn btn-danger w-100 mt-auto delete-model-link">Delete model</a>
				{% endif %}
				{% if app.user %}
				<button type="button" class="btn btn-outline-danger btn-light text-danger w-100 mt-3" data-bs-toggle="modal" data-bs-target="#ratingModal">Add Review</button>
				{% endif %}
			</aside>

		</div>
	</div>

	<!-- Modal: Rating form -->
	<div class="modal fade" id="ratingModal" tabindex="-1" aria-labelledby="ratingModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="ratingModalLabel">Add review</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<form id="ajax-rating-form" enctype="multipart/form-data">
						<div class="row g-4">
							<div class="col-md-6">
								<label class="form-label small fw-bold">Engine</label>
								<select name="motor" class="form-select border-0 bg-light p-3" style="border-radius: 15px;" required>
									{% if motores is defined and motores|length > 0 %}
										{% for motor in motores %}
											<option value="{{ motor.nombreMotor }}">{{ motor.nombreMotor }}</option>
										{% endfor %}
									{% else %}
										<option>No engines available</option>
									{% endif %}
								</select>
							</div>
							<div class="col-md-6">
								<label class="form-label small fw-bold">Transmission</label>
								<select name="transmision" class="form-select border-0 bg-light p-3" style="border-radius: 15px;" required>
									<option value="A">Automatic</option>
									<option value="M">Manual</option>
								</select>
							</div>
							<div class="col-md-12">
								<label class="form-label small fw-bold">Stars</label>
								<div class="star-rating-form">
									{% for i in 5..1 %}
										<input type="radio" name="puntuacion" id="star{{i}}" value="{{i}}" required>
										<label for="star{{i}}">
											<svg viewbox="0 0 24 24">
												<path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
											</svg>
										</label>
									{% endfor %}
								</div>
							</div>
							<div class="col-md-6">
								<label class="form-label small fw-bold">Color</label>
								<input type="text" name="color" class="form-control border-0 bg-light p-3" style="border-radius: 15px;" placeholder="Ej: Red" required>
							</div>
							<div class="col-md-6">
								<label class="form-label small fw-bold">Year</label>
								<input type="number" name="anio" class="form-control border-0 bg-light p-3" style="border-radius: 15px;" placeholder="2024" required>
							</div>
							<div class="col-12">
								<textarea name="opinion" class="form-control border-0 bg-light p-3" style="border-radius: 15px;" rows="3" placeholder="Your analisis..."></textarea>
							</div>
							<div class="col-12">
								<input type="hidden" name="anadir_garaje" value="0">
								<div class="form-check form-switch">
									<input class="form-check-input" type="checkbox" id="anadirGaraje" name="anadir_garaje" value="1">
									<label class="form-check-label" for="anadirGaraje">Add to your garage</label>
								</div>
							</div>
							<div class="col-12" id="notas-propietario-container" style="display: none;">
								<label class="form-label small fw-bold">Owner's note (optional)</label>
								<textarea id="notasPropietario" name="notas_propietario" class="form-control border-0 bg-light p-3" style="border-radius: 15px;" rows="3" placeholder="Add notes about your car (optional)"></textarea>
								<div class="mt-3">
									<label class="form-label small fw-bold">Images of your car (optional)</label>
									<input type="file" id="garajeImage" name="garaje_image[]" class="form-control" accept="image/*" multiple>
									<div class="form-text small text-white">You can upload multiple images (jpg, png...).</div>
								</div>
							</div>
							<div class="col-12">
								<button type="submit" id="submit-form-btn" class="btn btn-primary w-100 py-3 fw-bold" style="border-radius: 18px;">Post review</button>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	  </div>
{% endblock %}
